# Copy to .env (git-ignored) to override defaults. Dummy credentials only: never put real secrets here.
APP_PORT=8080
DYNAMODB_PORT=8000
LOCALSTACK_PORT=4566

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

ORDERS_QUEUE_NAME=orders
ORDERS_DLQ_NAME=orders-dlq
ORDERS_MAX_RECEIVE_COUNT=3

# Secret for admin routes (X-Admin-Key), e.g. POST /events/{id}/complimentary. Empty = admin routes disabled (403).
# Set a value ONLY in your git-ignored .env, generated randomly (e.g. `openssl rand -hex 32`). Real deployments: secrets manager.
ADMIN_API_KEY=
